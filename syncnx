#!/usr/bin/env bash
# sync data/ between phone and PC (scripts/sync.py)
#
#   ./syncnx [args...]
#
# all arguments are passed to sync.py. the Python used is
# $NXSHELL_PYTHON, or python3, or python. it runs from the
# repo folder, so data/ is found wherever it is started from.

cd "$(dirname "$0")" || exit 1

python=${NXSHELL_PYTHON:-}
if [ -z "$python" ]; then
    python=$(command -v python3 || command -v python)
fi
if [ -z "$python" ]; then
    echo "error: python not found, install it or set" \
        "NXSHELL_PYTHON=/path/to/python" >&2
    exit 1
fi

exec "$python" scripts/sync.py "$@"
