#!/usr/bin/env bash
# mtsig: mail trades service, runs
# scripts/order_watcher.py in the background
#
#   ./mtsig start    start it (does nothing if it is
#                    already running)
#   ./mtsig start force
#                    also when another device runs
#                    the background tasks
#   ./mtsig stop     stop it cleanly (SIGTERM), force
#                    it after 20s
#   ./mtsig status   running or not, its heartbeat and
#                    the last log lines
#   ./mtsig restart  stop, then start
#
# the Python used is $WATCHER_PYTHON, or the first of
# python3.14, python3, python that is 3.14 or newer.
# in Termux a wake lock is taken while it runs, so
# Android doesn't pause it. only one device runs the
# background tasks (scripts/tasks_owner.py): start
# refuses when another device runs them.

set -u
cd "$(dirname "$0")" || exit 1
WATCHER_SCRIPT=scripts/order_watcher.py
OWNER_SCRIPT=scripts/tasks_owner.py
NEEDS_314='import sys; sys.exit(sys.version_info < (3, 14))'

find_python() {
    local candidates="${WATCHER_PYTHON:-} python3.14"
    for candidate in $candidates python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c "$NEEDS_314" 2>/dev/null
        then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# any python can read the config, only the watcher
# itself needs 3.14
CONFIG_PYTHON=$(command -v python3 || command -v python)
# storage_dir is relative to the repo root, like in
# scripts/storage.py
READ_DIR='import json
print(json.load(open("config.json"))["storage_dir"])'
DATA_DIR=$("$CONFIG_PYTHON" -c "$READ_DIR") || exit 1
DATA_DIR=${DATA_DIR%/}
LOG_DIR="$DATA_DIR/logs"
PID_FILE="$DATA_DIR/mtsig.pid"
LOG_FILE="$LOG_DIR/mtsig.log"
# python errors that happen before logging is set up
# (e.g. a missing package)
OUT_FILE="$LOG_DIR/mtsig.out"

running_pid() {
    # print the pid if order_watcher.py from the pid
    # file is alive
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null ||
        return 1
    # make sure the pid was not reused by another program
    local args
    if [ -r "/proc/$pid/cmdline" ]; then
        args=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    else
        args=$(ps -p "$pid" -o args= 2>/dev/null)
    fi
    echo "$args" | grep -q order_watcher.py || return 1
    echo "$pid"
}

ladder_running() {
    # a ladder (scripts/ladder.py, started from the
    # shell) still needs the wake lock; [.] keeps grep
    # from matching its own command line
    grep -qsa "scripts/ladder[.]py" /proc/[0-9]*/cmdline
}

wake_lock() {
    # $1: termux-wake-lock or termux-wake-unlock
    command -v "$1" >/dev/null 2>&1 && "$1"
}

release_if_idle() {
    # no ladder runs either: release the wake lock and
    # the background tasks, so the other device may run
    # them
    ladder_running && return 0
    wake_lock termux-wake-unlock
    "$CONFIG_PYTHON" "$OWNER_SCRIPT" release
}

start() {
    # $1: force or empty
    local pid
    if pid=$(running_pid); then
        echo "mail broker is already running (pid $pid)"
        return 0
    fi
    local python
    if ! python=$(find_python); then
        echo "error: order_watcher.py needs Python" \
            "3.14 or newer, set" \
            "WATCHER_PYTHON=/path/to/python3.14" >&2
        return 1
    fi
    # prints why it refuses
    "$CONFIG_PYTHON" "$OWNER_SCRIPT" claim ${1:+"$1"} ||
        return 1
    mkdir -p "$LOG_DIR"
    wake_lock termux-wake-lock

    LOG_CONSOLE=0 nohup "$python" "$WATCHER_SCRIPT" \
        > "$OUT_FILE" 2>&1 < /dev/null &
    pid=$!
    echo "$pid" > "$PID_FILE"

    # catch an immediate crash, e.g. a wrong password or
    # missing .env settings
    sleep 3
    if running_pid >/dev/null; then
        local version
        version=$("$python" --version 2>&1)
        echo "mail broker started (pid $pid, $version)," \
            "log: $LOG_FILE"
        return 0
    fi
    rm -f "$PID_FILE"
    release_if_idle
    echo "error: mail broker stopped right after" \
        "starting:" >&2
    if [ -s "$OUT_FILE" ]; then
        tail -n 15 "$OUT_FILE" >&2
    elif [ -f "$LOG_FILE" ]; then
        # the CRITICAL line and the exception at the end
        # of its traceback
        grep -E " (CRITICAL|ERROR) " "$LOG_FILE" |
            tail -n 1 >&2
        tail -n 1 "$LOG_FILE" >&2
        echo "full traceback in $LOG_FILE" >&2
    fi
    return 1
}

stop() {
    local pid
    if ! pid=$(running_pid); then
        echo "mail broker is not running"
        rm -f "$PID_FILE"
        return 0
    fi
    # SIGTERM is handled like Ctrl+C: clean logout,
    # 'stopped' heartbeat
    kill -TERM "$pid"
    for _ in $(seq 20); do
        running_pid >/dev/null || break
        sleep 1
    done
    if running_pid >/dev/null; then
        echo "mail broker did not stop in 20s, killing it"
        kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$PID_FILE"
    release_if_idle
    echo "mail broker stopped"
}

status() {
    local pid
    if pid=$(running_pid); then
        echo "mail broker is running (pid $pid)"
    else
        echo "mail broker is not running"
    fi
    # the heartbeat that order_watcher.py writes, also
    # shown by 'status' in ./nxshell
    "$CONFIG_PYTHON" - "$DATA_DIR/mtsig_status.json" \
        <<'PY'
import json, sys
try:
    status = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit()
print(f"  state:      {status.get('state')}, "
      f"updated {status.get('updated')}")
print(f"  started:    {status.get('started')}")
if status.get("last_order"):
    print(f"  last order: {status['last_order']}")
error = status.get("last_error")
if error:
    print(f"  last error: {error.get('time')} "
          f"{error.get('text')}")
PY
    if [ -f "$LOG_FILE" ]; then
        echo "last log lines ($LOG_FILE):"
        tail -n 5 "$LOG_FILE" | cut -c1-200 |
            sed 's/^/  /'
    fi
    [ -n "$pid" ]
}

case "${1:-} ${2:-}" in
    "start " | "start force") start "${2:-}" ;;
    "stop ") stop ;;
    "status ") status ;;
    "restart ") stop && start ;;
    *)
        echo "usage:" \
            "./mtsig start [force]|stop|status|restart" \
            >&2
        exit 2
        ;;
esac
