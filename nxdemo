#!/usr/bin/env bash
# start the nX-sig demo: the shell (scripts/commands.py)
# with sample data, no keys or accounts needed. NX_DEMO=1
# makes config.py read demo/config.json, so the data is
# in demo_data/ and the real data/ is never touched
#
#   ./nxdemo
#
# the Python used is $NXSHELL_PYTHON, or python3, or
# python. it runs from the repo folder, so demo/ is
# found wherever it is started from.

cd "$(dirname "$0")" || exit 1

python=${NXSHELL_PYTHON:-}
if [ -z "$python" ]; then
    python=$(command -v python3 || command -v python)
fi
if [ -z "$python" ]; then
    echo "error: python not found, install it or set" \
        "NXSHELL_PYTHON=/path/to/python" >&2
    exit 1
fi

export NX_DEMO=1
exec "$python" scripts/commands.py "$@"
